{
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "discord@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(github-pr-comment *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(git tag *)",
      "Bash(git worktree add *)",
      "Bash(git worktree list *)",
      "Bash(gh auth status *)",
      "Bash(gh repo view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue close *)",
      "Bash(gh label list *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh secret list *)",
      "Bash(gh search *)",
      "Bash(gh api repos/*)",
      "Bash(gh api /repos/*)",
      "Bash(gh api orgs/*)",
      "Bash(gh api /orgs/*)",
      "Bash(gh api user*)",
      "Bash(gh api /user*)",
      "Bash(gh api search/*)",
      "Bash(gh api /search/*)",
      "Bash(gh api rate_limit*)",
      "Bash(gh api /rate_limit*)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git branch -D *)",
      "Bash(gh api * -X *)",
      "Bash(gh api * --method *)",
      "Bash(gh api * --method=*)",
      "Bash(gh api repos/*/transfer*)",
      "Bash(gh api /repos/*/transfer*)",
      "Bash(gh api repos/*/keys*)",
      "Bash(gh api /repos/*/keys*)",
      "Bash(gh api repos/*/hooks*)",
      "Bash(gh api /repos/*/hooks*)",
      "Bash(gh api repos/*/dispatches*)",
      "Bash(gh api /repos/*/dispatches*)",
      "Bash(gh api repos/*/pulls/*/reviews*)",
      "Bash(gh api /repos/*/pulls/*/reviews*)",
      "Bash(gh api orgs/*/invitations*)",
      "Bash(gh api /orgs/*/invitations*)"
    ],
    "deny": [
      "Bash(gh repo delete *)",
      "Bash(gh auth token *)",
      "Bash(gh secret set *)"
    ]
  }
}
