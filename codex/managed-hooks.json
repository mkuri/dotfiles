{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/pre_tool_use.py\"",
            "timeout": 5,
            "statusMessage": "Checking command approval policy"
          }
        ]
      }
    ]
  }
}
