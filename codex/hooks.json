{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/projects/agent-status-bar/session-state-recorder/record-codex-session-state.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/projects/agent-status-bar/session-state-recorder/record-codex-session-state.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/projects/agent-status-bar/session-state-recorder/record-codex-session-state.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/pre_tool_use.py\"",
            "timeout": 5,
            "statusMessage": "Checking command approval policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/projects/agent-status-bar/session-state-recorder/record-codex-session-state.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/projects/agent-status-bar/session-state-recorder/record-codex-session-state.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
